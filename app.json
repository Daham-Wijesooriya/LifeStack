{
  "expo": {
    "name": "LifeStack",
    "slug": "LifeStack",
    "scheme": "lifestack",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/lifestack_icon_1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifestack.app"
    },
    "android": {
      "package": "com.lifestack.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFD082",
        "foregroundImage": "./assets/lifestack_foreground_1024.png",
        "backgroundImage": "./assets/lifestack_background_1024.png",
        "monochromeImage": "./assets/lifestack_monochrome_1024.png"
      },
      "predictiveBackGestureEnabled": true,
      "edgeToEdge": true
    },
    "web": {
      "favicon": "./assets/lifestack_icon_1024.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}